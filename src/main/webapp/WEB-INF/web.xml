<?xml version="1.0" encoding="UTF-8"?>
<!-- ======================================================================= -->
<!-- web.xml — Web Application Deployment Descriptor                          -->
<!-- ======================================================================= -->
<!-- This file configures the Java servlet container (Tomcat). It defines:     -->
<!--   - The display name of the application                                  -->
<!--   - The welcome file (default page when visiting the root URL)           -->
<!--                                                                          -->
<!-- In more complex apps, this file would also define:                        -->
<!--   - Servlet mappings (URL → Java class routing)                          -->
<!--   - Filters (request/response interceptors)                              -->
<!--   - Listeners (application lifecycle hooks)                              -->
<!--   - Security constraints (authentication requirements)                   -->
<!--                                                                          -->
<!-- For this learning project, we keep it minimal — just enough to serve     -->
<!-- the index.jsp page at the application root (/).                          -->
<!-- ======================================================================= -->
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <!-- Human-readable name shown in Tomcat's manager console -->
    <display-name>Pipeline to Actions Web App</display-name>

    <!-- Welcome file list — Tomcat serves these files (in order) when a   -->
    <!-- user visits the root URL (e.g., http://your-alb-dns.com/).        -->
    <!-- The first file found in the list wins.                            -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

</web-app>

